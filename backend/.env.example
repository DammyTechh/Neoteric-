# ─────────────────────────────────────────────────────────────────────────────
#  Neoteric LP — API v2 · environment template
#  Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://www.neotericlp.com.ng

# Public URL of the marketing site (used to build links inside emails).
SITE_URL=https://www.neotericlp.com.ng
# Public URL of the admin dashboard (used for password-reset / invite links).
ADMIN_URL=http://localhost:3000/admin

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key. SERVER ONLY — it bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — only used by the optional public read-only client.
SUPABASE_ANON_KEY=
# Storage bucket that backs the media library.
SUPABASE_STORAGE_BUCKET=neoteric-media

# Direct Postgres connection string. Only needed by `npm run db:migrate`.
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=neoteric-api
JWT_AUDIENCE=neoteric-admin
BCRYPT_ROUNDS=12

# Account lockout policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Seeded super-admin ───────────────────────────────────────────────────────
# There is no public registration. This single account is created by
# `npm run db:seed:admin` and is the only way into the dashboard.
SEED_ADMIN_EMAIL=admin@neotericlp.com.ng
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Neoteric Administrator

# ── Mail (Resend over SMTP) ──────────────────────────────────────────────────
# Resend → API Keys. Username is literally "resend"; password is the API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM_NAME=Neoteric LP
MAIL_FROM_EMAIL=no-reply@neotericlp.com.ng
MAIL_REPLY_TO=info@neotericlp.com.ng
# Where contact-form notifications land.
MAIL_ADMIN_RECIPIENTS=info@neotericlp.com.ng
# Set true to log emails to stdout instead of sending (handy in dev).
MAIL_DRY_RUN=false

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=15
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/avif,image/svg+xml,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PUBLIC_FORM_RATE_LIMIT_MAX=5
