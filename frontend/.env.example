# Backend API base URL, including the /api/v1 prefix.
#   Local:   http://localhost:4000/api/v1
#   Vercel:  https://<your-backend-project>.vercel.app/api/v1
# Browser requests go through this site's own /api/v1 path (see next.config.mjs),
# which proxies to this URL, so the admin login cookie stays first-party.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public site URL, used for canonical links and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://www.neotericlp.com.ng
